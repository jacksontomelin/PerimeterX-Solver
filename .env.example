# PerimeterX Solver Configuration
# Copy this file to .env and fill in your values

# PerimeterX Application ID
# Extract from the target website's PerimeterX script
PX_APP_ID=PX0OZADU9K

# Fingerprint Type
# Usually 221 for standard implementations
PX_FT=221

# Collector API URI
# Format: https://collector-{app_id}.px-cloud.net/api/v{version}/collector
PX_COLLECTOR_URI=https://collector-px0ozadu9k.px-cloud.net/api/v2/collector

# Target website URL
PX_HOST=https://airtable.com/login

# Session ID - MUST be extracted fresh for each attempt
# Extract from website in real-time using Selenium/Playwright
PX_SID=474b6227-54f2-11ef-a959-cc2d2dcd99ae

# Visitor ID - MUST be extracted fresh for each attempt
# Extract from website in real-time using Selenium/Playwright
PX_VID=49bf0cb5-5697-11ef-84ed-4e092214a776

# Client Timestamp - MUST be extracted fresh for each attempt
# Extract from website in real-time using Selenium/Playwright
PX_CTS=49bf1545-5697-11ef-84ed-422d064a3602

# Optional: Proxy server
# Format: proxy_host:proxy_port
# Leave empty or commented out to not use a proxy
# PX_PROXY=proxy.example.com:8080
